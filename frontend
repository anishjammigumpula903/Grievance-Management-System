<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>SOT Grievance Student System</title>

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>

/* =========================
   GLOBAL
========================= */

:root {
    --bg: #07111F;
    --surface: #0E1D2E;
    --surface2: #152637;
    --border: rgba(255,255,255,0.08);
    --border2: rgba(255,255,255,0.15);

    --text: #E8EEF6;
    --muted: #6C86A1;

    --blue: #2D8CFF;
    --green: #00D4AA;

    --yellow: #F59E0B;
    --purple: #8B5CF6;
    --red: #EF4444;
    --success: #10B981;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
}

button,
input,
textarea,
select {
    font-family: inherit;
}

/* =========================
   SCROLLBAR
========================= */

::-webkit-scrollbar {
    width: 6px;
}

::-webkit-scrollbar-track {
    background: var(--bg);
}

::-webkit-scrollbar-thumb {
    background: var(--surface2);
    border-radius: 10px;
}

/* =========================
   ANIMATIONS
========================= */

@keyframes fadeIn {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

@keyframes fadeUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* =========================
   NAVBAR
========================= */

.nav {
    height: 62px;
    padding: 0 2rem;

    display: flex;
    align-items: center;
    justify-content: space-between;

    position: sticky;
    top: 0;
    z-index: 100;

    background: rgba(7,17,31,0.9);
    backdrop-filter: blur(20px);

    border-bottom: 1px solid var(--border);
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;

    font-family: 'Playfair Display', serif;
    font-size: 18px;
    font-weight: 700;

    color: white;
}

.logo-badge {
    width: 36px;
    height: 36px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 10px;

    background: linear-gradient(
        135deg,
        var(--blue),
        var(--green)
    );

    font-family: 'DM Mono', monospace;
    font-weight: bold;
}

.nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
}

/* =========================
   BUTTONS
========================= */

.btn {
    padding: 9px 18px;

    border-radius: 8px;
    border: none;

    cursor: pointer;

    font-size: 14px;
    font-weight: 500;

    transition: 0.2s;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
}

.btn:hover {
    transform: translateY(-1px);
}

.btn-primary {
    background: linear-gradient(
        135deg,
        var(--blue),
        var(--green)
    );

    color: white;
}

.btn-primary:hover {
    opacity: 0.9;
}

.btn-secondary {
    background: rgba(255,255,255,0.06);
    border: 1px solid var(--border2);
    color: var(--text);
}

.btn-secondary:hover {
    background: rgba(255,255,255,0.11);
}

.btn-admin {
    background: rgba(239,68,68,0.12);
    color: #FF7885;

    border: 1px solid rgba(239,68,68,0.3);
}

.btn-admin:hover {
    background: rgba(239,68,68,0.2);
}

.btn-large {
    padding: 13px 28px;
    font-size: 16px;
}

/* =========================
   PAGES
========================= */

.page {
    display: none;
    min-height: calc(100vh - 62px);
}

.page.active {
    display: block;
    animation: fadeIn 0.3s ease;
}

/* =========================
   LANDING PAGE
========================= */

.hero {
    max-width: 900px;
    margin: auto;

    text-align: center;

    padding: 80px 20px 60px;
}

.hero-tag {
    display: inline-block;

    padding: 7px 18px;

    border-radius: 50px;

    background: rgba(45,140,255,0.1);
    border: 1px solid rgba(45,140,255,0.3);

    color: var(--blue);

    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;

    margin-bottom: 25px;
}

.hero h1 {
    font-family: 'Playfair Display', serif;

    font-size: clamp(40px, 6vw, 62px);

    line-height: 1.1;

    margin-bottom: 20px;

    background: linear-gradient(
        135deg,
        white 40%,
        #6AB4FF
    );

    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.hero p {
    max-width: 600px;

    margin: auto auto 35px;

    color: var(--muted);

    line-height: 1.8;

    font-size: 16px;
}

.hero-buttons {
    display: flex;
    justify-content: center;
    gap: 15px;

    flex-wrap: wrap;
}

/* =========================
   STATS
========================= */

.stats {
    max-width: 900px;

    margin: 0 auto 60px;

    padding: 0 20px;

    display: grid;
    grid-template-columns: repeat(4,1fr);

    gap: 15px;
}

.stat-card {
    background: var(--surface);

    border: 1px solid var(--border);

    border-radius: 14px;

    padding: 22px;

    text-align: center;
}

.stat-icon {
    font-size: 25px;

    margin-bottom: 8px;
}

.stat-number {
    font-family: 'Playfair Display', serif;

    font-size: 38px;

    font-weight: 800;

    color: white;
}

.stat-label {
    color: var(--muted);

    font-size: 12px;

    margin-top: 5px;
}

/* =========================
   FEATURES
========================= */

.features {
    max-width: 900px;

    margin: auto;

    padding: 0 20px 70px;

    display: grid;

    grid-template-columns: repeat(3,1fr);

    gap: 15px;
}

.feature {
    background: var(--surface);

    border: 1px solid var(--border);

    border-radius: 14px;

    padding: 22px;
}

.feature-icon {
    font-size: 28px;

    margin-bottom: 12px;
}

.feature h3 {
    font-family: 'Playfair Display', serif;

    color: white;

    margin-bottom: 8px;
}

.feature p {
    color: var(--muted);

    font-size: 13px;

    line-height: 1.6;
}

/* =========================
   LOGIN
========================= */

.login-wrapper {
    min-height: calc(100vh - 62px);

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 30px;
}

.login-card {
    width: 100%;
    max-width: 430px;

    padding: 40px;

    background: var(--surface);

    border: 1px solid var(--border);

    border-radius: 20px;

    animation: fadeUp 0.4s ease;
}

.login-card h2 {
    font-family: 'Playfair Display', serif;

    color: white;

    font-size: 28px;

    margin-bottom: 5px;
}

.login-card > p {
    color: var(--muted);

    font-size: 14px;

    margin-bottom: 30px;
}

/* =========================
   FORMS
========================= */

.form-group {
    margin-bottom: 18px;
}

.form-label {
    display: block;

    color: #9BB2C8;

    font-size: 12px;

    font-weight: 600;

    margin-bottom: 7px;
}

.form-input,
.form-select,
.form-textarea {
    width: 100%;

    padding: 12px 14px;

    background: rgba(255,255,255,0.05);

    border: 1px solid var(--border2);

    border-radius: 9px;

    color: var(--text);

    outline: none;

    font-size: 14px;
}

.form-input:focus,
.form-select:focus,
.form-textarea:focus {
    border-color: var(--blue);
}

.form-textarea {
    resize: vertical;
}

.form-select option {
    background: var(--surface);
}

.demo {
    margin-top: 20px;

    padding: 14px;

    border-radius: 10px;

    background: rgba(45,140,255,0.08);

    color: #6AB4FF;

    font-size: 12px;

    line-height: 1.5;
}

/* =========================
   PORTAL
========================= */

.portal {
    display: flex;

    height: calc(100vh - 62px);
}

/* SIDEBAR */

.sidebar {
    width: 215px;

    flex-shrink: 0;

    background: var(--surface);

    border-right: 1px solid var(--border);

    padding: 20px 12px;
}

.sidebar-title {
    color: var(--muted);

    font-size: 10px;

    letter-spacing: 2px;

    text-transform: uppercase;

    margin-bottom: 10px;

    padding: 0 10px;
}

.nav-item {
    width: 100%;

    padding: 11px;

    margin-bottom: 3px;

    display: flex;
    align-items: center;

    gap: 10px;

    background: transparent;

    color: var(--muted);

    border: 1px solid transparent;

    border-radius: 9px;

    cursor: pointer;

    text-align: left;

    font-size: 14px;
}

.nav-item:hover {
    color: white;

    background: rgba(255,255,255,0.04);
}

.nav-item.active {
    color: #6AB4FF;

    background: rgba(45,140,255,0.1);

    border-color: rgba(45,140,255,0.25);
}

/* MAIN CONTENT */

.main {
    flex: 1;

    overflow-y: auto;

    padding: 35px;
}

.page-header {
    margin-bottom: 28px;
}

.page-header h2 {
    font-family: 'Playfair Display', serif;

    color: white;

    font-size: 28px;

    margin-bottom: 5px;
}

.page-header p {
    color: var(--muted);

    font-size: 14px;
}

/* =========================
   DASHBOARD
========================= */

.dashboard-stats {
    display: grid;

    grid-template-columns: repeat(4,1fr);

    gap: 15px;

    margin-bottom: 30px;
}

.dashboard-stat {
    background: var(--surface);

    border: 1px solid var(--border);

    border-radius: 13px;

    padding: 20px;
}

.dashboard-stat-top {
    display: flex;

    justify-content: space-between;

    margin-bottom: 10px;
}

.dashboard-value {
    font-family: 'Playfair Display', serif;

    font-size: 30px;

    color: white;
}

.dashboard-label {
    color: var(--muted);

    font-size: 12px;
}

.stat-line {
    height: 3px;

    border-radius: 20px;

    margin-top: 15px;

    background: linear-gradient(
        90deg,
        var(--blue),
        var(--green)
    );
}

/* =========================
   GRIEVANCE CARDS
========================= */

.grievance-list {
    display: flex;

    flex-direction: column;

    gap: 10px;
}

.grievance-card {
    background: var(--surface);

    border: 1px solid var(--border);

    border-radius: 12px;

    padding: 18px;

    cursor: pointer;

    transition: 0.2s;
}

.grievance-card:hover {
    background: var(--surface2);

    border-color: rgba(45,140,255,0.35);

    transform: translateY(-1px);
}

.grievance-top {
    display: flex;

    justify-content: space-between;

    gap: 15px;

    margin-bottom: 10px;
}

.grievance-id {
    color: var(--blue);

    font-family: 'DM Mono', monospace;

    font-size: 12px;

    margin-bottom: 4px;
}

.grievance-title {
    color: white;

    font-family: 'Playfair Display', serif;

    font-size: 16px;
}

.grievance-meta {
    display: flex;

    flex-wrap: wrap;

    gap: 15px;

    color: var(--muted);

    font-size: 12px;
}

/* =========================
   BADGES
========================= */

.badge {
    display: inline-flex;

    align-items: center;

    gap: 6px;

    padding: 5px 10px;

    border-radius: 20px;

    font-size: 11px;

    font-weight: 600;

    white-space: nowrap;
}

.dot {
    width: 6px;
    height: 6px;

    border-radius: 50%;
}

.pending {
    background: rgba(245,158,11,0.15);
    color: #F59E0B;
}

.pending .dot {
    background: #F59E0B;
}

.review {
    background: rgba(59,130,246,0.15);
    color: #60A5FA;
}

.review .dot {
    background: #60A5FA;
}

.progress {
    background: rgba(139,92,246,0.15);
    color: #A78BFA;
}

.progress .dot {
    background: #A78BFA;
}

.resolved {
    background: rgba(16,185,129,0.15);
    color: #34D399;
}

.resolved .dot {
    background: #34D399;
}

.rejected {
    background: rgba(239,68,68,0.15);
    color: #F87171;
}

.rejected .dot {
    background: #F87171;
}

/* PRIORITY */

.high {
    color: #F87171;
}

.medium {
    color: #FBBF24;
}

.low {
    color: #34D399;
}

/* =========================
   TRACK PAGE
========================= */

.track {
    max-width: 650px;

    margin: 70px auto;

    padding: 20px;
}

.track h2 {
    font-family: 'Playfair Display', serif;

    color: white;

    font-size: 32px;

    margin-bottom: 5px;
}

.track > p {
    color: var(--muted);

    margin-bottom: 25px;
}

.track-row {
    display: flex;

    gap: 10px;
}

.sample {
    margin-top: 25px;

    background: var(--surface);

    border-radius: 12px;

    padding: 18px;
}

.sample p {
    color: var(--muted);

    font-size: 12px;

    margin-bottom: 10px;
}

.sample-buttons {
    display: flex;

    flex-wrap: wrap;

    gap: 7px;
}

.sample button {
    background: rgba(255,255,255,0.05);

    border: 1px solid var(--border2);

    color: var(--text);

    padding: 7px 10px;

    border-radius: 6px;

    cursor: pointer;

    font-family: 'DM Mono', monospace;

    font-size: 11px;
}

.not-found {
    margin-top: 20px;

    padding: 20px;

    border-radius: 12px;

    background: rgba(239,68,68,0.08);

    border: 1px solid rgba(239,68,68,0.25);

    color: #F87171;

    text-align: center;
}

/* =========================
   MODAL
========================= */

.modal-overlay {
    position: fixed;

    inset: 0;

    background: rgba(0,0,0,0.75);

    backdrop-filter: blur(6px);

    display: none;

    align-items: center;

    justify-content: center;

    padding: 20px;

    z-index: 500;
}

.modal-overlay.open {
    display: flex;
}

.modal {
    width: 100%;

    max-width: 600px;

    max-height: 90vh;

    overflow-y: auto;

    background: #0B192A;

    border: 1px solid var(--border2);

    border-radius: 20px;

    padding: 30px;
}

.modal-header {
    display: flex;

    justify-content: space-between;

    margin-bottom: 20px;
}

.modal-id {
    color: var(--blue);

    font-family: 'DM Mono', monospace;

    font-size: 12px;
}

.modal-title {
    color: white;

    font-family: 'Playfair Display', serif;

    font-size: 23px;

    margin-top: 4px;
}

.close {
    background: none;

    border: none;

    color: var(--muted);

    font-size: 20px;

    cursor: pointer;
}

.modal-meta {
    display: flex;

    flex-wrap: wrap;

    gap: 8px;

    margin-bottom: 20px;
}

.meta {
    padding: 5px 10px;

    border-radius: 20px;

    background: rgba(255,255,255,0.05);

    border: 1px solid var(--border);

    color: var(--muted);

    font-size: 11px;
}

.modal-description {
    color: #8BA8C4;

    line-height: 1.7;

    font-size: 14px;

    margin-bottom: 20px;
}

.admin-note {
    padding: 15px;

    background: rgba(45,140,255,0.08);

    border: 1px solid rgba(45,140,255,0.2);

    border-radius: 10px;

    color: #93C5FD;

    font-size: 13px;

    line-height: 1.6;
}

.admin-note strong {
    display: block;

    color: var(--blue);

    font-size: 10px;

    letter-spacing: 1px;

    text-transform: uppercase;

    margin-bottom: 5px;
}

/* =========================
   FILTER
========================= */

.filters {
    display: flex;

    gap: 10px;

    margin-bottom: 20px;

    flex-wrap: wrap;
}

.filters input {
    max-width: 250px;
}

/* =========================
   REPORTS
========================= */

.reports {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 20px;
}

.report-card {
    background: var(--surface);

    border: 1px solid var(--border);

    border-radius: 15px;

    padding: 22px;
}

.report-card.full {
    grid-column: 1 / -1;
}

.report-card h3 {
    font-family: 'Playfair Display', serif;

    color: white;

    margin-bottom: 20px;
}

.bar-row {
    margin-bottom: 15px;
}

.bar-info {
    display: flex;

    justify-content: space-between;

    color: #9BB2C8;

    font-size: 12px;

    margin-bottom: 5px;
}

.bar {
    height: 6px;

    background: rgba(255,255,255,0.07);

    border-radius: 20px;

    overflow: hidden;
}

.bar-fill {
    height: 100%;

    background: linear-gradient(
        90deg,
        var(--blue),
        var(--green)
    );

    border-radius: 20px;
}

.priority-grid {
    display: grid;

    grid-template-columns: repeat(3,1fr);

    gap: 12px;
}

.priority-box {
    padding: 20px;

    border-radius: 12px;

    text-align: center;

    background: rgba(255,255,255,0.04);
}

.priority-number {
    font-family: 'Playfair Display', serif;

    font-size: 32px;

    color: white;
}

.priority-label {
    font-size: 12px;

    margin-top: 5px;
}

/* =========================
   EMPTY
========================= */

.empty {
    text-align: center;

    padding: 60px 20px;

    color: var(--muted);
}

.empty-icon {
    font-size: 50px;

    margin-bottom: 10px;
}

/* =========================
   NOTIFICATION
========================= */

#notification {
    position: fixed;

    top: 80px;
    right: 20px;

    z-index: 1000;

    display: none;

    padding: 14px 20px;

    border-radius: 10px;

    font-size: 13px;

    box-shadow: 0 10px 30px rgba(0,0,0,0.4);
}

#notification.show {
    display: block;
}

.notification-success {
    background: #0D3D26;

    border: 1px solid rgba(16,185,129,0.4);

    color: #34D399;
}

.notification-error {
    background: #3D0D0D;

    border: 1px solid rgba(239,68,68,0.4);

    color: #F87171;
}

/* =========================
   RESPONSIVE
========================= */

@media(max-width:800px) {

    .stats,
    .dashboard-stats {
        grid-template-columns: repeat(2,1fr);
    }

    .features {
        grid-template-columns: 1fr;
    }

    .reports {
        grid-template-columns: 1fr;
    }

    .report-card.full {
        grid-column: auto;
    }

    .sidebar {
        width: 180px;
    }

    .main {
        padding: 20px;
    }
}

@media(max-width:600px) {

    .nav {
        padding: 0 12px;
    }

    .logo {
        font-size: 14px;
    }

    .nav-actions .btn {
        padding: 7px 10px;
        font-size: 11px;
    }

    .portal {
        flex-direction: column;

        height: auto;
    }

    .sidebar {
        width: 100%;

        display: flex;

        overflow-x: auto;

        padding: 10px;
    }

    .sidebar-title {
        display: none;
    }

    .nav-item {
        width: auto;

        white-space: nowrap;
    }

    .hero {
        padding-top: 50px;
    }

    .stats {
        grid-template-columns: 1fr 1fr;
    }

    .track-row {
        flex-direction: column;
    }
}

</style>
</head>

<body>

<!-- =========================
     NOTIFICATION
========================= -->

<div id="notification"></div>


<!-- =========================
     NAVBAR
========================= -->

<nav class="nav">

    <div class="logo">

        <div class="logo-badge">
            S
        </div>

        SOT Grievance Portal

    </div>

    <div class="nav-actions" id="navActions">

        <button
            class="btn btn-secondary"
            onclick="showPage('track')">
            Track Grievance
        </button>

        <button
            class="btn btn-primary"
            onclick="showPage('login')">
            Student Login
        </button>

        <button
            class="btn btn-admin"
            onclick="adminLogin()">
            Admin Access
        </button>

    </div>

</nav>


<!-- =========================
     LANDING PAGE
========================= -->

<section
    id="page-landing"
    class="page active">

    <div class="hero">

        <div class="hero-tag">
            School of Technology · Grievance System
        </div>

        <h1>
            Student Grievance<br>
            Redressal System
        </h1>

        <p>
            A transparent, efficient platform to submit,
            track, and resolve academic and administrative
            grievances — digitised for speed and accountability.
        </p>

        <div class="hero-buttons">

            <button
                class="btn btn-primary btn-large"
                onclick="showPage('login')">
                Submit a Grievance
            </button>

            <button
                class="btn btn-secondary btn-large"
                onclick="showPage('track')">
                Track Your Complaint
            </button>

        </div>

    </div>


    <!-- STATS -->

    <div class="stats">

        <div class="stat-card">

            <div class="stat-icon">
                📋
            </div>

            <div
                class="stat-number"
                id="totalStat">
                0
            </div>

            <div class="stat-label">
                Total Grievances
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon">
                ⏳
            </div>

            <div
                class="stat-number"
                id="pendingStat">
                0
            </div>

            <div class="stat-label">
                Pending Review
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon">
                🔄
            </div>

            <div
                class="stat-number"
                id="progressStat">
                0
            </div>

            <div class="stat-label">
                In Progress
            </div>

