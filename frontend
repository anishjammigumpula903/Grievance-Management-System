                    : "My Grievances"
                }
            </h2>

            <p id="listCount">
                ${list.length} records
            </p>

        </div>


        ${
            isAdmin
            ? `

                <div class="filters">

                    <input
                        class="form-input"
                        id="search"
                        placeholder="Search grievances..."
                        oninput="filterGrievances()">


                    <select
                        class="form-select"
                        id="statusFilter"
                        onchange="filterGrievances()">

                        <option>
                            All
                        </option>

                        ${STATUS_LIST.map(
                            s =>
                            `<option>
                                ${s}
                            </option>`
                        ).join("")}

                    </select>

                </div>

            `
            : ""
        }


        <div
            class="grievance-list"
            id="grievanceList">

            ${
                list.length
                ? list
                    .map(
                        g =>
                        grievanceCard(
                            g,
                            isAdmin
                        )
                    )
                    .join("")
                : emptyState(!isAdmin)
            }

        </div>

    `;

}


/* =====================================================
   FILTER
===================================================== */

function filterGrievances() {

    const search =
        document
        .getElementById("search")
        .value
        .toLowerCase();


    const status =
        document
        .getElementById("statusFilter")
        .value;


    const filtered =
        grievances.filter(g => {

            const searchMatch =
                !search ||
                g.id.toLowerCase().includes(search) ||
                g.studentName.toLowerCase().includes(search) ||
                g.title.toLowerCase().includes(search);


            const statusMatch =
                status === "All" ||
                g.status === status;


            return searchMatch && statusMatch;

        });


    document
        .getElementById("grievanceList")
        .innerHTML =
        filtered.length
        ? filtered
            .map(g => grievanceCard(g,true))
            .join("")
        : emptyState(false);


    document
        .getElementById("listCount")
        .textContent =
        filtered.length + " records";

}


