/* =====================================================
   GRIEVANCE CARD
===================================================== */

function statusClass(status) {

    if (status === "Pending")
        return "pending";

    if (status === "Under Review")
        return "review";

    if (status === "In Progress")
        return "progress";

    if (status === "Resolved")
        return "resolved";

    if (status === "Rejected")
        return "rejected";

    return "pending";

}


function badge(status) {

    return `

        <span class="badge ${statusClass(status)}">

            <span class="dot"></span>

            ${status}

        </span>

    `;

}


function priorityHTML(priority) {

    return `

        <span class="${priority.toLowerCase()}">

            ⚠ ${priority}

        </span>

    `;

}


function grievanceCard(g, showStudent) {

    return `

        <div
            class="grievance-card"
            onclick="openModal('${g.id}')">


            <div class="grievance-top">

                <div>

                    <div class="grievance-id">
                        ${g.id}
                    </div>

                    <div class="grievance-title">
                        ${g.title}
                    </div>

                </div>

                ${badge(g.status)}

            </div>


            <div class="grievance-meta">

                <span>
                    📁 ${g.category}
                </span>


                ${
                    showStudent
                    ? `
                        <span>
                            👤 ${g.studentName}
                            (${g.rollNo})
                        </span>
                    `
                    : ""
                }


                <span>
                    📅 ${g.date}
                </span>


                <span>
                    ${priorityHTML(g.priority)}
                </span>

            </div>

        </div>

    `;

}


