            <div class="form-group">

                <label class="form-label">
                    Admin Note
                </label>

                <textarea
                    class="form-textarea"
                    id="adminNote"
                    rows="4">${grievance.adminNote}</textarea>

            </div>


            <button
                class="btn btn-primary"
                onclick="
                    saveGrievance('${grievance.id}')
                ">

                Save Changes

            </button>

        `;

    }

    else {

        update.innerHTML = "";

    }


    document
        .getElementById("modal")
        .classList.add("open");

}


/* =====================================================
   CLOSE MODAL
===================================================== */

function closeModal(event) {

    if (
        !event ||
        event.target ===
        document.getElementById("modal")
    ) {

        document
            .getElementById("modal")
            .classList.remove("open");

    }

}


/* =====================================================
   ADMIN UPDATE
===================================================== */

function saveGrievance(id) {

    const grievance =
        grievances.find(
            g => g.id === id
        );


    if (!grievance)
        return;


    grievance.status =
        document
        .getElementById("updateStatus")
        .value;


    grievance.adminNote =
        document
        .getElementById("adminNote")
        .value;


    document
        .getElementById("modal")
        .classList.remove("open");


    renderTab(currentTab);

    updateLandingStats();


    notify(
        "Grievance updated successfully!"
    );

}


/* =====================================================
   SUBMIT GRIEVANCE
===================================================== */

function submitGrievance() {

    const category =
        document
        .getElementById("category")
        .value;


    const priority =
        document
        .getElementById("priority")
        .value;


    const title =
        document
        .getElementById("grievanceTitle")
        .value.trim();


    const description =
        document
        .getElementById("description")
        .value.trim();


    if (
        !category ||
        !title ||
        !description
    ) {

        notify(
            "Please fill all required fields.",
            "error"
        );

        return;

    }


    const id =
        "SOT-2024-" +
        String(idCounter++)
        .padStart(3,"0");


    grievances.unshift({

        id: id,

        studentName:
        currentUser.name,

        rollNo:
        currentUser.rollNo,

        category:
        category,

        title:
        title,

        description:
        description,

        status:
        "Pending",

        date:
        new Date()
        .toISOString()
        .split("T")[0],

        adminNote:
        "",

        priority:
        priority

    });


    notify(
        "Grievance submitted! ID: " + id
    );


    updateLandingStats();


    renderTab("my");

}


/* =====================================================
   TRACK GRIEVANCE
===================================================== */

function renderSampleButtons() {

    document
        .getElementById("sampleButtons")
        .innerHTML =

        grievances
        .slice(0,5)
        .map(g => `

            <button
                onclick="
                    quickTrack('${g.id}')
                ">

                ${g.id}

            </button>

        `)
        .join("");

}


function quickTrack(id) {

    document
        .getElementById("trackInput")
        .value = id;


    trackGrievance();

}


function trackGrievance() {

    const id =
        document
        .getElementById("trackInput")
        .value
        .trim();


    const grievance =
        grievances.find(
            g => g.id === id
        );


    const result =
        document
        .getElementById("trackResult");


    if (!grievance) {

        result.innerHTML = `

            <div class="not-found">

                ❌ No grievance found
                with ID

                <strong>
                    ${id || "(blank)"}
                </strong>

            </div>

        `;

        return;

    }


    result.innerHTML = `

        <div
            class="grievance-card"
            style="
                cursor:default;
                margin-top:20px;
            ">


            <div class="grievance-top">

                <div>

                    <div class="grievance-id">
                        ${grievance.id}
                    </div>

                    <div class="grievance-title">
                        ${grievance.title}
                    </div>

                </div>

                ${badge(grievance.status)}

            </div>


            <div class="grievance-meta">

                <span>
                    📁 ${grievance.category}
                </span>

                <span>
                    👤 ${grievance.studentName}
                </span>

                <span>
                    📅 ${grievance.date}
                </span>

                <span>
                    ${priorityHTML(
                        grievance.priority
                    )}
                </span>

            </div>


            <p
                style="
                    color:#8BA8C4;
                    line-height:1.7;
                    margin-top:15px;
                    font-size:14px;
                ">

                ${grievance.description}

            </p>


            ${
                grievance.adminNote
                ? `

                    <div
                        class="admin-note"
                        style="margin-top:15px">

                        <strong>
                            Admin Response
                        </strong>

                        ${grievance.adminNote}

                    </div>

                `
                : ""
            }

        </div>

    `;

}


/* =====================================================
   REPORTS
===================================================== */

function renderReports() {

    const total =
        grievances.length || 1;


    const categoryCounts = {};


    CATEGORIES.forEach(category => {

        categoryCounts[category] =
            grievances.filter(
                g => g.category === category
            ).length;

    });


    const statusCounts = {};


    STATUS_LIST.forEach(status => {

        statusCounts[status] =
            grievances.filter(
                g => g.status === status
            ).length;

    });


    return `

        <div class="page-header">

            <h2>
                Reports & Analytics
            </h2>

            <p>
                Insights across all
                ${grievances.length}
                grievances.
            </p>

        </div>


        <div class="reports">


            <div class="report-card">

                <h3>
                    📁 By Category
                </h3>

                ${CATEGORIES
                    .filter(
                        c =>
                        categoryCounts[c] > 0
                    )
                    .map(
                        category => `

                        <div class="bar-row">

                            <div class="bar-info">

                                <span>
                                    ${category}
                                </span>

                                <span>
                                    ${categoryCounts[category]}
                                </span>

                            </div>

                            <div class="bar">

                                <div
                                    class="bar-fill"
                                    style="
                                        width:
                                        ${
                                            categoryCounts[category]
                                            /
                                            total
                                            * 100
                                        }%
                                    ">
                                </div>

                            </div>

                        </div>

                    `
                    )
                    .join("")}

            </div>


            <div class="report-card">

                <h3>
                    📊 By Status
                </h3>

                ${STATUS_LIST.map(
                    status => `

                    <div class="bar-row">

                        <div class="bar-info">

                            <span>
                                ${status}
                            </span>

                            <span>
                                ${statusCounts[status]}
                            </span>

                        </div>

                        <div class="bar">

                            <div
                                class="bar-fill"
                                style="
                                    width:
                                    ${
                                        statusCounts[status]
                                        /
                                        total
                                        * 100
                                    }%;
                                ">
                            </div>

                        </div>

                    </div>

                `
                ).join("")}

            </div>


            <div class="report-card full">

                <h3>
                    ⚠️ Priority Distribution
                </h3>


                <div class="priority-grid">


                    <div class="priority-box">

                        <div
                            class="priority-number"
                            style="color:#F87171">

                            ${
                                grievances.filter(
                                    g =>
                                    g.priority === "High"
                                ).length
                            }

                        </div>

                        <div
                            class="priority-label"
                            style="color:#F87171">

                            High Priority

                        </div>

                    </div>


                    <div class="priority-box">

                        <div
                            class="priority-number"
                            style="color:#FBBF24">

                            ${
                                grievances.filter(
                                    g =>
                                    g.priority === "Medium"
                                ).length
                            }

                        </div>

                        <div
                            class="priority-label"
                            style="color:#FBBF24">

                            Medium Priority

                        </div>

                    </div>


                    <div class="priority-box">

                        <div
                            class="priority-number"
                            style="color:#34D399">

                            ${
                                grievances.filter(
                                    g =>
                                    g.priority === "Low"
                                ).length
                            }

                        </div>

                        <div
                            class="priority-label"
                            style="color:#34D399">

                            Low Priority

                        </div>

                    </div>


                </div>

            </div>

        </div>

    `;

}


/* =====================================================
   INITIALIZE
===================================================== */

updateLandingStats();

</script>

</body>
</html>
