===================================================== */

function notify(message, type = "success") {

    const notification =
        document.getElementById("notification");

    notification.textContent =
        type === "error"
        ? "⚠️ " + message
        : "✅ " + message;

    notification.className =
        type === "error"
        ? "show notification-error"
        : "show notification-success";

    setTimeout(() => {

        notification.className = "";

    }, 3500);
}


/* =====================================================
   PAGE NAVIGATION
===================================================== */

function showPage(pageName) {

    document
        .querySelectorAll(".page")
        .forEach(page => {

            page.classList.remove("active");

        });


    document
        .getElementById("page-" + pageName)
        .classList.add("active");


    if (pageName === "landing") {

        updateLandingStats();

    }


    if (pageName === "track") {

        renderSampleButtons();

    }

}


/* =====================================================
   STATISTICS
===================================================== */

function getStats(list) {

    return {

        total: list.length,

        pending:
        list.filter(
            g => g.status === "Pending"
        ).length,

        progress:
        list.filter(
            g =>
            g.status === "In Progress" ||
            g.status === "Under Review"
        ).length,

        resolved:
        list.filter(
            g => g.status === "Resolved"
        ).length

    };

}


function updateLandingStats() {

    const stats = getStats(grievances);

    document.getElementById("totalStat")
