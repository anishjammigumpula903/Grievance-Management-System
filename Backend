    }


# ============================================================
# 26. ROUTE — STUDENT SIGNUP
# ============================================================

@app.post("/auth/signup", response_model=TokenResponse)
def signup(

    payload: StudentSignup,

    db: Session = Depends(get_db),

):

    existing = (

        db.query(User)

        .filter(User.roll_no == payload.roll_no)

        .first()

    )

    if existing:

        raise HTTPException(

            status_code=400,

            detail="A user with this roll number already exists",

        )


    user = User(

        id=payload.roll_no,

        name=payload.name,

        roll_no=payload.roll_no,

        email=payload.email,

        hashed_password=hash_password(payload.password),

        is_admin=False,

    )

    db.add(user)

    db.commit()


    token = create_access_token({"sub": user.roll_no})

    return TokenResponse(

        access_token=token,

        is_admin=False,

        name=user.name,

    )


# ============================================================
# 27. ROUTE — LOGIN
# ============================================================

@app.post("/auth/login", response_model=TokenResponse)
def login(

    payload: LoginRequest,

    db: Session = Depends(get_db),

):

    user = (

        db.query(User)

        .filter(User.roll_no == payload.roll_no)

        .first()

    )

    if not user or not verify_password(payload.password, user.hashed_password):

        raise HTTPException(

            status_code=401,

            detail="Invalid roll number or password",

        )


    token = create_access_token({"sub": user.roll_no})

    return TokenResponse(

        access_token=token,

        is_admin=user.is_admin,

        name=user.name,

    )


# ============================================================
# 28. ROUTE — SUBMIT GRIEVANCE
# ============================================================

@app.post("/grievances", response_model=GrievanceOut, status_code=201)
def submit_grievance(

    payload: GrievanceCreate,

    db: Session = Depends(get_db),

    current_user: User = Depends(get_current_user),

):

    return submit_grievance_record(db, payload, current_user)


# ============================================================
# 29. ROUTE — MY GRIEVANCES
# ============================================================

@app.get("/grievances/mine", response_model=List[GrievanceOut])
def my_grievances(

    db: Session = Depends(get_db),

    current_user: User = Depends(get_current_user),

):

