# ============================================================
# 31. ROUTE — LIST / FILTER ALL GRIEVANCES (ADMIN)
# ============================================================

@app.get("/grievances", response_model=List[GrievanceOut])
def list_all_grievances(

    status_filter: Optional[str] = Query(None, alias="status"),

    search: Optional[str] = Query(None),

    db: Session = Depends(get_db),

    current_user: User = Depends(require_admin),

):

    return filter_grievances(db, status_filter, search)


# ============================================================
# 32. ROUTE — UPDATE GRIEVANCE (ADMIN)
# ============================================================

@app.patch("/grievances/{grievance_id}", response_model=GrievanceOut)
