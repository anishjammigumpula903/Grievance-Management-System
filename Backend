# ============================================================
# 33. ROUTE — REPORTS AND ANALYTICS (ADMIN)
# ============================================================

@app.get("/reports/stats", response_model=StatsOut)
def get_stats(

    db: Session = Depends(get_db),

    current_user: User = Depends(require_admin),

):

    return build_stats(db)


